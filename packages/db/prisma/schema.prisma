// =============================================================================
// Velor House — Prisma schema (PostgreSQL)
// -----------------------------------------------------------------------------
// Everything the storefront and dashboards render is stored here. Adding a
// product, banner, collection, landing page, coupon, blog post, menu item or
// changing any setting is a data change — never a code change.
//
// Sections:
//   1.  Identity, roles & access control
//   2.  Customers, addresses, wallet & loyalty
//   3.  Catalog: brands, categories, collections, products, variants, media
//   4.  Inventory
//   5.  Reviews & Q&A
//   6.  Cart & wishlist
//   7.  Orders, payments, fulfilment, shipments, returns
//   8.  Pricing: coupons, promotions, tax, shipping rates
//   9.  CMS: banners, home sections, menus, landing pages, blog, lookbooks
//   10. Marketing & engagement: newsletter, testimonials, instagram, alerts
//   11. Search & analytics
//   12. Notifications & messaging templates
//   13. Settings, integrations & audit log
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // Emit a single SQL statement with LATERAL joins for `include`/`select`
  // instead of one round-trip per relation. Cuts p95 latency dramatically when
  // the DB is not on the same host as the API.
  previewFeatures = ["relationJoins"]
  // "native" covers local dev; the debian targets cover Render / most Linux
  // hosts (Debian, OpenSSL 3.x and 1.1.x) so the query engine is always present.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// 1. IDENTITY, ROLES & ACCESS CONTROL
// =============================================================================

enum UserKind {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING_VERIFICATION
}

model User {
  id                String     @id @default(cuid())
  kind              UserKind   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  email             String?    @unique
  emailVerifiedAt   DateTime?
  phone             String?    @unique
  phoneVerifiedAt   DateTime?
  passwordHash      String?
  firstName         String?
  lastName          String?
  displayName       String?
  avatarUrl         String?
  dateOfBirth       DateTime?
  gender            Gender?
  locale            String     @default("en-IN")
  marketingOptIn    Boolean    @default(false)
  lastLoginAt       DateTime?
  isSuperAdmin      Boolean    @default(false)
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  roles             UserRole[]
  oauthAccounts     OAuthAccount[]
  refreshTokens     RefreshToken[]
  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  wishlist          WishlistItem[]
  reviews           Review[]
  questions         Question[]
  answers           Answer[]
  loyaltyAccount    LoyaltyAccount?
  walletTransactions WalletTransaction[]
  couponRedemptions CouponRedemption[]
  notifications     Notification[]
  stockAlerts       StockAlert[]
  productViews      ProductView[]
  searchQueries     SearchQuery[]
  referralsMade     Referral[]         @relation("Referrer")
  referralReceived  Referral?          @relation("Referred")
  auditLogs         AuditLog[]
  authoredPosts     BlogPost[]         @relation("PostAuthorUser")
  assignedTickets   SupportNote[]

  @@index([kind, status])
  @@index([createdAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // google | facebook | apple
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // Admin, Inventory Manager, Order Manager, Marketing Manager, Customer Support Manager
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false) // system roles cannot be deleted
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  // "resource:action" e.g. product:create, order:refund, settings:update
  key         String           @unique
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@index([resource])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

// =============================================================================
// 2. CUSTOMERS, ADDRESSES, WALLET & LOYALTY
// =============================================================================

enum Gender {
  MEN
  WOMEN
  UNISEX
  BOYS
  GIRLS
  BABY
}

enum AgeGroup {
  ADULT
  TEEN
  KIDS
  BABY
  ALL_AGES
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AddressType @default(SHIPPING)
  isDefault    Boolean     @default(false)
  fullName     String
  phone        String
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String      @default("IN")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([pincode])
}

model LoyaltyAccount {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance  Int                @default(0)
  lifetimePoints Int                @default(0)
  tier           String             @default("Bronze")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transactions   LoyaltyTransaction[]
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
  REFERRAL
  BIRTHDAY
  SIGNUP
  REVIEW
}

model LoyaltyTransaction {
  id          String         @id @default(cuid())
  accountId   String
  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        LoyaltyTxnType
  points      Int // positive = credit, negative = debit
  description String?
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([accountId])
}

enum WalletTxnType {
  CREDIT
  DEBIT
  REFUND
  CASHBACK
  ADJUSTMENT
}

model WalletTransaction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        WalletTxnType
  amount      Decimal       @db.Decimal(12, 2)
  balanceAfter Decimal      @db.Decimal(12, 2)
  currency    String        @default("INR")
  description String?
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  createdAt   DateTime      @default(now())

  @@index([userId])
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId    String?  @unique
  referred      User?    @relation("Referred", fields: [referredId], references: [id])
  code          String   @unique
  referredEmail String?
  rewardIssued  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  initialValue  Decimal   @db.Decimal(12, 2)
  balance       Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  purchaserId   String?
  recipientEmail String?
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =============================================================================
// 3. CATALOG
// =============================================================================

model Brand {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  logoUrl         String?
  description     String?
  isFeatured      Boolean   @default(false)
  sortOrder       Int       @default(0)
  seo             Seo?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([isFeatured])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  gender        Gender?
  ageGroup      AgeGroup?
  imageUrl      String?
  bannerUrl     String?
  bannerMobileUrl String?
  iconUrl       String?
  seoContent    String? // rich text block rendered at the bottom of the category page
  isActive      Boolean    @default(true)
  isFeatured    Boolean    @default(false)
  showInMenu    Boolean    @default(true)
  sortOrder     Int        @default(0)
  path          String? // materialised path e.g. "men/shirts" for fast lookups
  seo           Seo?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  products      ProductCategory[]
  promotions    PromotionCategory[]

  @@index([parentId])
  @@index([isActive, isFeatured])
}

enum CollectionType {
  MANUAL
  AUTOMATED
}

model Collection {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  type           CollectionType @default(MANUAL)
  description    String?
  imageUrl       String?
  bannerUrl      String?
  bannerMobileUrl String?
  // For AUTOMATED collections: JSON rules, e.g.
  // { "all": [{ "field": "tag", "op": "in", "value": ["summer"] }, { "field": "price", "op": "lt", "value": 2000 }] }
  rules          Json?
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isPremium      Boolean        @default(false)
  isSeasonal     Boolean        @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int            @default(0)
  seo            Seo?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products       ProductCollection[]

  @@index([isActive, isFeatured])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String?       @unique
  barcode          String?
  status           ProductStatus @default(DRAFT)
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  shortDescription String?
  description      String? // rich HTML
  gender           Gender?
  ageGroup         AgeGroup?

  // Pricing (base — variants may override)
  currency         String        @default("INR")
  mrp              Decimal       @db.Decimal(12, 2)
  salePrice        Decimal       @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  taxClassId       String?
  taxClass         TaxClass?     @relation(fields: [taxClassId], references: [id])

  // Merchandising flags (each powers a homepage / PDP rail)
  isFeatured       Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isTrending       Boolean       @default(false)
  isHot            Boolean       @default(false)
  isStaffPick      Boolean       @default(false)
  isExclusive      Boolean       @default(false)

  // Denormalised aggregates (kept fresh by workers) for fast sorting/filtering
  ratingAverage    Float         @default(0)
  ratingCount      Int           @default(0)
  viewCount        Int           @default(0)
  soldCount        Int           @default(0)
  wishlistCount    Int           @default(0)

  publishedAt      DateTime?
  availableFrom    DateTime?
  metaTitle        String?
  seo              Seo?

  fabricDetails    String?
  careInstructions String?
  originCountry    String?
  weightGrams      Int?
  dimensionsJson   Json? // { length, width, height } in cm

  sizeGuideId      String?
  sizeGuide        SizeGuide?    @relation(fields: [sizeGuideId], references: [id])

  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  categories       ProductCategory[]
  collections      ProductCollection[]
  tags             ProductTag[]
  options          ProductOption[]
  variants         ProductVariant[]
  media            ProductMedia[]
  attributes       ProductAttributeValue[]
  reviews          Review[]
  questions        Question[]
  relatedFrom      ProductRelation[]  @relation("RelationSource")
  relatedTo        ProductRelation[]  @relation("RelationTarget")
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  stockAlerts      StockAlert[]
  views            ProductView[]
  promotions       PromotionProduct[]
  homeSectionItems HomeSectionItem[]
  lookItems        LookItem[]

  @@index([status, publishedAt])
  // Matches buildProductWhere()'s base filter used by every storefront listing,
  // facets and PDP query (status ACTIVE + deletedAt null + publishedAt <= now).
  @@index([status, deletedAt, publishedAt])
  // price_asc / price_desc sort and the min/max price facet filter.
  @@index([salePrice])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
  @@index([ratingAverage])
  @@index([soldCount])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// Variant axes, e.g. option "Size" with values S/M/L, option "Color" with values.
model ProductOption {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // Size | Color | Material | Pattern | Style
  position  Int                 @default(0)
  values    ProductOptionValue[]

  @@unique([productId, name])
}

model ProductOptionValue {
  id        String                     @id @default(cuid())
  optionId  String
  option    ProductOption              @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     String
  hexColor  String? // when the option is a colour
  position  Int                        @default(0)
  variants  ProductVariantOptionValue[]

  @@unique([optionId, value])
}

enum InventoryPolicy {
  DENY // stop selling at 0
  CONTINUE // allow backorder / made-to-order
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String   @unique
  barcode         String?
  // Optional per-variant price overrides
  mrp             Decimal? @db.Decimal(12, 2)
  salePrice       Decimal? @db.Decimal(12, 2)
  costPrice       Decimal? @db.Decimal(12, 2)
  weightGrams     Int?
  position        Int      @default(0)
  isActive        Boolean  @default(true)

  inventoryPolicy InventoryPolicy @default(DENY)

  optionValues    ProductVariantOptionValue[]
  media           ProductMedia[]
  inventory       InventoryLevel[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  stockAlerts     StockAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
}

model ProductVariantOptionValue {
  variantId     String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

enum MediaType {
  IMAGE
  VIDEO
  VIEW_360
  LIFESTYLE
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type      MediaType @default(IMAGE)
  url       String
  thumbnailUrl String?
  alt       String?
  position  Int       @default(0)
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())

  @@index([productId])
  @@index([variantId])
}

// Reusable spec keys, e.g. "Fit", "Neck", "Sleeve", "Closure".
model Attribute {
  id       String                  @id @default(cuid())
  name     String                  @unique
  slug     String                  @unique
  unit     String?
  isFilterable Boolean             @default(false)
  values   ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  @@unique([productId, attributeId])
  @@index([attributeId])
}

model SizeGuide {
  id        String    @id @default(cuid())
  name      String    @unique
  // Flexible table: { columns: [...], rows: [[...], ...], notes: "..." }
  content   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

enum ProductRelationType {
  SIMILAR
  FREQUENTLY_BOUGHT_TOGETHER
  COMPLETE_THE_LOOK
  CROSS_SELL
  UP_SELL
  ACCESSORY
}

model ProductRelation {
  id        String              @id @default(cuid())
  sourceId  String
  source    Product             @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    Product             @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      ProductRelationType
  position  Int                 @default(0)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
}

// =============================================================================
// 4. INVENTORY
// =============================================================================

model Warehouse {
  id        String           @id @default(cuid())
  name      String           @unique
  code      String           @unique
  addressJson Json?
  isActive  Boolean          @default(true)
  priority  Int              @default(0)
  levels    InventoryLevel[]
  createdAt DateTime         @default(now())
}

model InventoryLevel {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand        Int            @default(0)
  reserved      Int            @default(0)
  // available = onHand - reserved (computed in app layer)
  lowStockThreshold Int        @default(5)
  updatedAt     DateTime       @updatedAt

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  DAMAGE
  TRANSFER
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String?
  type        StockMovementType
  quantity    Int // signed
  reason      String?
  reference   String? // order id, PO number, etc.
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
}

// =============================================================================
// 5. REVIEWS & Q&A
// =============================================================================

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
  SPAM
}

model Review {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId           String?
  rating            Int // 1..5
  title             String?
  body              String?
  isVerifiedPurchase Boolean         @default(false)
  status            ModerationStatus @default(PENDING)
  helpfulCount      Int              @default(0)
  reportedCount     Int              @default(0)
  fitFeedback       String? // "Runs small" | "True to size" | "Runs large"
  adminReply        String?
  media             ReviewMedia[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productId, status])
  @@index([userId])
}

model ReviewMedia {
  id       String    @id @default(cuid())
  reviewId String
  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  type     MediaType @default(IMAGE)
  url      String
  position Int       @default(0)
}

model Question {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  status    ModerationStatus @default(PENDING)
  answers   Answer[]
  createdAt DateTime         @default(now())

  @@index([productId, status])
}

model Answer {
  id         String           @id @default(cuid())
  questionId String
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  body       String
  isStaff    Boolean          @default(false)
  status     ModerationStatus @default(PUBLISHED)
  helpfulCount Int            @default(0)
  createdAt  DateTime         @default(now())
}

// =============================================================================
// 6. CART & WISHLIST
// =============================================================================

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  MERGED
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken   String?    @unique // for guests
  status         CartStatus @default(ACTIVE)
  currency       String     @default("INR")
  couponCode     String?
  notes          String?
  abandonedEmailSentAt DateTime?
  convertedOrderId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items          CartItem[]

  @@index([userId])
  @@index([status, updatedAt])
}

model CartItem {
  id           String          @id @default(cuid())
  cartId       String
  cart         Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant  @relation(fields: [variantId], references: [id])
  quantity     Int             @default(1)
  unitPrice    Decimal         @db.Decimal(12, 2) // price snapshot at add time
  savedForLater Boolean        @default(false)
  addedAt      DateTime        @default(now())

  @@unique([cartId, variantId])
  @@index([productId])
}

model WishlistItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  notifyOnPriceDrop Boolean @default(false)
  createdAt DateTime        @default(now())

  @@unique([userId, productId, variantId])
  @@index([productId])
}

// =============================================================================
// 7. ORDERS, PAYMENTS, FULFILMENT, SHIPMENTS, RETURNS
// =============================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  PHONEPE
  PAYU
  UPI
  CARD
  NETBANKING
  COD
  WALLET
  GIFT_CARD
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // human friendly, e.g. SJ-2026-000123
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail        String?
  guestPhone        String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currency          String        @default("INR")
  itemsSubtotal     Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @db.Decimal(12, 2) @default(0)
  shippingTotal     Decimal       @db.Decimal(12, 2) @default(0)
  taxTotal          Decimal       @db.Decimal(12, 2) @default(0)
  walletUsed        Decimal       @db.Decimal(12, 2) @default(0)
  loyaltyPointsUsed Int           @default(0)
  grandTotal        Decimal       @db.Decimal(12, 2)
  refundedTotal     Decimal       @db.Decimal(12, 2) @default(0)

  couponCode        String?
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])

  // Address snapshots (immutable copies — the address book can change later)
  shippingAddress   Json
  billingAddress    Json

  customerNote      String?
  staffNote         String?
  cancelReason      String?
  ipAddress         String?
  channel           String        @default("web") // web | mobile | admin

  placedAt          DateTime      @default(now())
  confirmedAt       DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime      @updatedAt

  items             OrderItem[]
  statusHistory     OrderStatusEvent[]
  payments          Payment[]
  shipments         Shipment[]
  fulfillments      Fulfillment[]
  returns           ReturnRequest[]
  loyaltyTxns       LoyaltyTransaction[]
  walletTxns        WalletTransaction[]
  couponRedemption  CouponRedemption?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  // Snapshots so the line survives catalog edits/deletes
  productName    String
  variantLabel   String? // "M / Indigo"
  sku            String
  imageUrl       String?

  unitMrp        Decimal         @db.Decimal(12, 2)
  unitPrice      Decimal         @db.Decimal(12, 2)
  quantity       Int
  discountTotal  Decimal         @db.Decimal(12, 2) @default(0)
  taxRate        Decimal         @db.Decimal(5, 2)  @default(0)
  taxTotal       Decimal         @db.Decimal(12, 2) @default(0)
  lineTotal      Decimal         @db.Decimal(12, 2)

  quantityFulfilled Int          @default(0)
  quantityReturned  Int          @default(0)

  returnItems    ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  gateway           String? // razorpay | stripe | phonepe | payu
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  gatewayResponse   Json?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds           Refund[]

  @@index([orderId])
  @@index([gatewayPaymentId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Refund {
  id              String       @id @default(cuid())
  paymentId       String
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnRequestId String?
  amount          Decimal      @db.Decimal(12, 2)
  status          RefundStatus @default(PENDING)
  reason          String?
  gatewayRefundId String?
  destination     String       @default("original") // original | wallet
  processedAt     DateTime?
  createdAt       DateTime     @default(now())

  @@index([paymentId])
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RETURNED
}

model Fulfillment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId String?
  status      FulfillmentStatus @default(UNFULFILLED)
  lineItems   Json // [{ orderItemId, quantity }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shipment    Shipment?

  @@index([orderId])
}

enum ShipmentStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RTO
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentId  String?        @unique
  fulfillment    Fulfillment?   @relation(fields: [fulfillmentId], references: [id])
  provider       String // shiprocket | delhivery | bluedart
  awbNumber      String?
  courierName    String?
  trackingUrl    String?
  status         ShipmentStatus @default(LABEL_CREATED)
  // Provider's own status label, verbatim (e.g. "PICKUP SCHEDULED", "CANCELED",
  // "RTO DELIVERED"). Shown in the UI when it is more specific than `status`.
  rawStatus      String?
  labelUrl       String?
  manifestUrl    String?
  invoiceUrl     String?
  estimatedDelivery DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  weightGrams    Int?

  // --- Shiprocket identifiers / metadata -----------------------------------
  providerOrderId    String? // Shiprocket order_id
  providerShipmentId String? // Shiprocket shipment_id
  courierId          Int?    // Shiprocket courier_company_id
  pickupLocation     String? // pickup nickname used
  pickupScheduledAt  DateTime?
  pickupTokenNumber  String?
  freightCharge      Decimal? @db.Decimal(12, 2)
  appliedWeightGrams Int?
  lastSyncedAt       DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  trackingEvents ShipmentEvent[]

  @@index([orderId])
  @@index([awbNumber])
  @@index([providerShipmentId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  location   String?
  message    String?
  occurredAt DateTime
  createdAt  DateTime       @default(now())

  @@index([shipmentId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  REFUNDED
  CLOSED
}

enum ReturnReasonCode {
  SIZE_TOO_SMALL
  SIZE_TOO_LARGE
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  QUALITY_ISSUE
  CHANGED_MIND
  OTHER
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rmaNumber    String       @unique
  status       ReturnStatus @default(REQUESTED)
  type         String       @default("return") // return | exchange
  reasonCode   ReturnReasonCode
  comment      String?
  media        Json? // uploaded photos of the issue
  pickupAddress Json?
  refundAmount Decimal?     @db.Decimal(12, 2)
  refundMethod String? // original | wallet
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items        ReturnItem[]

  @@index([orderId])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  restock         Boolean       @default(true)

  @@index([returnRequestId])
}

// =============================================================================
// 8. PRICING: COUPONS, PROMOTIONS, TAX, SHIPPING
// =============================================================================

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BOGO
}

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  description        String?
  type               CouponType
  value              Decimal    @db.Decimal(12, 2) @default(0) // percent or amount
  maxDiscountAmount  Decimal?   @db.Decimal(12, 2)
  minOrderAmount     Decimal?   @db.Decimal(12, 2)

  appliesTo          String     @default("all") // all | category | product | collection | brand
  targetIds          String[]   @default([])

  isFirstOrderOnly   Boolean    @default(false)
  isNewCustomerOnly  Boolean    @default(false)
  isStackable        Boolean    @default(false)

  usageLimit         Int? // total redemptions allowed
  usageLimitPerUser  Int        @default(1)
  usedCount          Int        @default(0)

  // If set, only these users can redeem (user-specific coupons)
  allowedUserIds     String[]   @default([])

  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  redemptions        CouponRedemption[]
  orders             Order[]

  @@index([isActive, endsAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

enum PromotionType {
  CART_DISCOUNT
  PRODUCT_DISCOUNT
  CATEGORY_DISCOUNT
  BUY_X_GET_Y
  FIRST_ORDER
  TIERED_SPEND
  FESTIVAL
}

// Automatic offers that apply without a code (e.g. "Festival Sale 30% off Ethnic Wear").
model Promotion {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  type          PromotionType
  description   String?
  discountType  DiscountType  @default(PERCENTAGE)
  discountValue Decimal       @db.Decimal(12, 2) @default(0)
  // Free-form config for BOGO / tiered rules
  config        Json?
  priority      Int           @default(0)
  isStackable   Boolean       @default(false)
  isActive      Boolean       @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  bannerText    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  products      PromotionProduct[]
  categories    PromotionCategory[]

  @@index([isActive, endsAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model PromotionProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

enum TaxType {
  GST
  VAT
  SALES_TAX
}

model TaxClass {
  id        String    @id @default(cuid())
  name      String    @unique // "Apparel 5%", "Apparel 12%", "Footwear 18%"
  rate      Decimal   @db.Decimal(5, 2)
  type      TaxType   @default(GST)
  isInclusive Boolean @default(true) // whether displayed prices already include tax
  hsnCode   String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String         @unique
  // list of pincodes / states / countries this zone covers
  regions   Json
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id            String       @id @default(cuid())
  zoneId        String
  zone          ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name          String // "Standard", "Express"
  price         Decimal      @db.Decimal(12, 2)
  freeAboveAmount Decimal?   @db.Decimal(12, 2)
  minDeliveryDays Int?
  maxDeliveryDays Int?
  codAvailable  Boolean      @default(true)
  codFee        Decimal      @db.Decimal(12, 2) @default(0)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
}

// Authoritative PIN-code directory + serviceability list. Rows are created on
// demand from the India Post lookup (source = "indiapost") and cached here so
// repeat checkouts never hit the external API; ops can also add/curate rows
// (source = "manual") and flip prepaidAvailable / codAvailable to block a PIN.
model ServiceablePincode {
  pincode        String   @id
  city           String?
  district       String?
  state          String?
  codAvailable   Boolean  @default(true)
  prepaidAvailable Boolean @default(true)
  etaMinDays     Int?
  etaMaxDays     Int?
  source         String   @default("manual") // "indiapost" | "manual" | "fallback"
  verifiedAt     DateTime?
  updatedAt      DateTime @updatedAt
}

// =============================================================================
// 9. CMS: BANNERS, HOME SECTIONS, MENUS, LANDING PAGES, BLOG, LOOKBOOKS
// =============================================================================

// Reusable SEO block attached to any indexable entity.
model Seo {
  id             String   @id @default(cuid())
  metaTitle      String?
  metaDescription String?
  metaKeywords   String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  noindex        Boolean  @default(false)
  structuredData Json? // JSON-LD override

  productId      String?     @unique
  product        Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId     String?     @unique
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collectionId   String?     @unique
  collection     Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  brandId        String?     @unique
  brand          Brand?      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pageId         String?     @unique
  page           Page?       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blogPostId     String?     @unique
  blogPost       BlogPost?   @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
  CATEGORY_TOP
  PROMO_BAR
  POPUP
  FOOTER
  SIDEBAR
}

model Banner {
  id            String          @id @default(cuid())
  title         String
  placement     BannerPlacement
  imageUrl      String?
  imageMobileUrl String?
  videoUrl      String?
  headline      String?
  subheadline   String?
  ctaLabel      String?
  ctaUrl        String?
  textColor     String?
  overlayOpacity Float          @default(0)
  countdownEndsAt DateTime? // powers the campaign countdown timer
  position      Int             @default(0)
  isActive      Boolean         @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([placement, isActive])
}

enum HomeSectionType {
  FEATURED
  BEST_SELLERS
  NEW_ARRIVALS
  TRENDING
  MOST_VIEWED
  HOT
  RECOMMENDED
  FLASH_SALE
  RECENTLY_ADDED
  TOP_RATED
  STAFF_PICKS
  COLLECTION_GRID
  CATEGORY_GRID
  BANNER
  LOOKBOOK
  BLOG
  TESTIMONIALS
  INSTAGRAM
  NEWSLETTER
  CUSTOM
}

// Ordered, toggleable blocks that compose the homepage (and other CMS pages).
model HomeSection {
  id           String          @id @default(cuid())
  type         HomeSectionType
  title        String?
  subtitle     String?
  // How to fill a product rail: "auto" uses the type's rule; "manual" uses items[]
  source       String          @default("auto") // auto | manual
  // Optional filter for auto mode: { categorySlug, collectionSlug, brandSlug, limit }
  config       Json?
  ctaLabel     String?
  ctaUrl       String?
  position     Int             @default(0)
  isActive     Boolean         @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items        HomeSectionItem[]

  @@index([isActive, position])
}

model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  // For non-product tiles (collection/category/custom card)
  imageUrl  String?
  label     String?
  url       String?
  position  Int         @default(0)

  @@index([sectionId])
}

model Menu {
  id        String     @id @default(cuid())
  name      String     @unique // "Main Nav", "Footer - Shop", "Footer - Help"
  location  String     @unique // header | footer-1 | footer-2 | mobile
  items     MenuItem[]
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id        String     @id @default(cuid())
  menuId    String
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuTree")
  label     String
  url       String
  iconUrl   String?
  imageUrl  String? // for mega-menu feature tiles
  badge     String? // "New", "Sale"
  openInNewTab Boolean @default(false)
  position  Int        @default(0)
  isActive  Boolean    @default(true)

  @@index([menuId, parentId])
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Landing page builder: a page is an ordered list of typed blocks (JSON).
model Page {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  type          String        @default("landing") // landing | campaign | brand | collection | info
  status        PublishStatus @default(DRAFT)
  // [{ type: "hero", props: {...} }, { type: "productGrid", props: {...} }, ...]
  blocks        Json          @default("[]")
  themeJson     Json? // colours / fonts overrides for campaign pages
  headerVariant String        @default("default")
  footerVariant String        @default("default")
  publishedAt   DateTime?
  scheduledAt   DateTime?
  seo           Seo?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  description String?
  posts     BlogPost[]
}

model BlogTag {
  id    String            @id @default(cuid())
  name  String            @unique
  slug  String            @unique
  posts BlogPostTag[]
}

model BlogPost {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?
  content       Json          @default("[]") // block content
  coverImageUrl String?
  status        PublishStatus @default(DRAFT)
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id])
  authorUserId  String?
  author        User?         @relation("PostAuthorUser", fields: [authorUserId], references: [id])
  readingMinutes Int?
  viewCount     Int           @default(0)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  seo           Seo?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tags          BlogPostTag[]
  relatedPosts  BlogPostRelation[] @relation("PostRelSource")
  relatedFrom   BlogPostRelation[] @relation("PostRelTarget")

  @@index([status, publishedAt])
}

model BlogPostTag {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogPostRelation {
  sourceId String
  source   BlogPost @relation("PostRelSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   BlogPost @relation("PostRelTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
}

model Lookbook {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  coverImageUrl String?
  season       String?
  isActive     Boolean    @default(true)
  position     Int        @default(0)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  looks        Look[]
}

// A single styled look / outfit within a lookbook; also powers "Complete the Look".
model Look {
  id         String     @id @default(cuid())
  lookbookId String?
  lookbook   Lookbook?  @relation(fields: [lookbookId], references: [id], onDelete: SetNull)
  title      String?
  imageUrl   String
  // hotspots: [{ x: 0.42, y: 0.6, productId: "..." }]
  hotspots   Json?
  position   Int        @default(0)
  items      LookItem[]
}

model LookItem {
  id        String  @id @default(cuid())
  lookId    String
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@unique([lookId, productId])
}

// =============================================================================
// 10. MARKETING & ENGAGEMENT
// =============================================================================

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?
  avatarUrl  String?
  rating     Int      @default(5)
  quote      String
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model InstagramPost {
  id          String   @id @default(cuid())
  externalId  String   @unique
  imageUrl    String
  permalink   String
  caption     String?
  productIds  String[] @default([]) // shoppable tags
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  postedAt    DateTime?
}

model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  status        String    @default("subscribed") // subscribed | unsubscribed | pending
  source        String? // footer | popup | checkout
  firstName     String?
  tags          String[]  @default([])
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  createdAt     DateTime  @default(now())
}

model StockAlert {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String?
  notifiedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([productId, variantId])
}

// =============================================================================
// 11. SEARCH & ANALYTICS
// =============================================================================

model SearchQuery {
  id           String   @id @default(cuid())
  term         String
  normalizedTerm String
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String?
  resultCount  Int      @default(0)
  clickedProductId String?
  channel      String   @default("web")
  createdAt    DateTime @default(now())

  @@index([normalizedTerm])
  @@index([createdAt])
}

// Curated / pinned search suggestions and synonyms managed from the dashboard.
model SearchTerm {
  id          String   @id @default(cuid())
  term        String   @unique
  isTrending  Boolean  @default(false)
  isPromoted  Boolean  @default(false)
  synonyms    String[] @default([])
  redirectUrl String? // "search for gift card" -> /gift-cards
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model ProductView {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String?
  source       String? // search | category | recommendation | direct
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionToken, createdAt])
}

// Pre-aggregated daily metrics for dashboards (filled by a nightly job).
model DailyMetric {
  date              DateTime @id @db.Date
  revenue           Decimal  @db.Decimal(14, 2) @default(0)
  orders            Int      @default(0)
  units             Int      @default(0)
  newCustomers      Int      @default(0)
  returningCustomers Int     @default(0)
  sessions          Int      @default(0)
  addToCarts        Int      @default(0)
  checkouts         Int      @default(0)
  abandonedCarts    Int      @default(0)
  refunds           Decimal  @db.Decimal(14, 2) @default(0)
  conversionRate    Float    @default(0)
  averageOrderValue Decimal  @db.Decimal(12, 2) @default(0)
}

// =============================================================================
// 12. NOTIFICATIONS & MESSAGING TEMPLATES
// =============================================================================

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  SHIPMENT_UPDATE
  PRICE_DROP
  BACK_IN_STOCK
  PROMOTION
  ABANDONED_CART
  REVIEW_REQUEST
  LOYALTY
  SYSTEM
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  type      NotificationType
  status    NotificationStatus  @default(QUEUED)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  @@index([userId, status])
  @@index([type])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  key       String              @unique // order.confirmed, order.shipped, otp.login ...
  channel   NotificationChannel
  name      String
  subject   String? // email only
  body      String // supports {{variables}}
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt
}

// =============================================================================
// 13. SETTINGS, INTEGRATIONS & AUDIT LOG
// =============================================================================

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SECRET
}

// Central key/value store for every configurable option shown in Super Admin.
model Setting {
  id        String           @id @default(cuid())
  group     String // general | payment | shipping | tax | email | sms | whatsapp | security | seo | checkout
  key       String           @unique
  value     Json
  valueType SettingValueType @default(STRING)
  label     String?
  isSecret  Boolean          @default(false)
  updatedById String?
  updatedAt DateTime         @updatedAt

  @@index([group])
}

model Integration {
  id          String   @id @default(cuid())
  provider    String   @unique // razorpay | stripe | phonepe | payu | shiprocket | delhivery | bluedart | msg91 | ...
  category    String // payment | shipping | sms | email | whatsapp | analytics
  isEnabled   Boolean  @default(false)
  isTestMode  Boolean  @default(true)
  // Encrypted at the application layer before saving.
  credentials Json?
  config      Json?
  lastCheckedAt DateTime?
  status      String   @default("unconfigured") // unconfigured | ok | error
  updatedAt   DateTime @updatedAt
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  BULK_UPDATE
  STATUS_CHANGE
  REFUND
  PERMISSION_CHANGE
  SETTING_CHANGE
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String? // snapshot: "Priya (Order Manager)"
  action     AuditAction
  entityType String // Product | Order | Setting | Role | ...
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Internal notes / handoffs on an order for the support team.
model SupportNote {
  id         String   @id @default(cuid())
  orderId    String?
  subject    String?
  body       String
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  isResolved Boolean  @default(false)
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
}

// Dashboard-managed URL redirects (301/302) for SEO during re-platforming / renames.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
}

// One-time passcodes for mobile-number customer authentication. The plaintext
// code is never stored — only a salted SHA-256 hash. A challenge is single-use
// (consumedAt), time-limited (expiresAt) and attempt-limited (attempts).
model OtpChallenge {
  id          String    @id @default(cuid())
  phone       String // E.164, e.g. +919000000000
  codeHash    String
  purpose     String    @default("auth")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  resendCount Int       @default(0)
  lastSentAt  DateTime  @default(now())
  consumedAt  DateTime?
  expiresAt   DateTime
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}
