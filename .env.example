# =============================================================================
# Velor House — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Core URLs
# -----------------------------------------------------------------------------
# Public URL of the customer storefront
WEB_URL=http://localhost:3000
# Public URL of the admin dashboard
ADMIN_URL=http://localhost:3001
# Public URL of the API (used by web/admin to call the backend)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# MSG91 "Secure OTP" widget (customer login) — OPTIONAL build-time override.
# Normally you don't set these: the storefront fetches the widget id + token
# from the API (GET /auth/otp/config), which reads MSG91_WIDGET_ID /
# MSG91_WIDGET_TOKEN_AUTH from the API env (see the SMS section below). Set these
# NEXT_PUBLIC_* vars only if you'd rather bake the values into the web bundle.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# The app uses interactive transactions (order placement), which need a real
# session — NOT a PgBouncer transaction-mode pooler. Point DATABASE_URL at a
# direct connection, or a session-mode pooler. DIRECT_URL is used for migrations.
# For local Docker they are the same.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://velor:velor@localhost:5432/velor_house?schema=public
DIRECT_URL=postgresql://velor:velor@localhost:5432/velor_house?schema=public

# -----------------------------------------------------------------------------
# Redis (cache, sessions, queues, rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Product search
#   SEARCH_DRIVER=postgres        -> built-in, no extra infrastructure (default)
#   SEARCH_DRIVER=elasticsearch   -> requires a reachable ELASTICSEARCH_NODE;
#                                    run `pnpm --filter @slay/api search:reindex`
#                                    (or POST /api/v1/admin/search/reindex) once.
# If Elasticsearch is unreachable at runtime, search automatically falls back to
# the Postgres query, so the storefront never breaks.
# -----------------------------------------------------------------------------
SEARCH_DRIVER=postgres
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PRODUCT_INDEX=products

# -----------------------------------------------------------------------------
# Auth / JWT
# Generate secrets with:  openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-cookie-secret

# OAuth (optional — leave blank to disable a provider)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Media storage (product images / video)
#   Leave AWS_* / S3_BUCKET blank  -> uploads are saved to ./uploads and served
#                                     at /uploads/* (LOCAL DEV ONLY — these are
#                                     wiped on every Render deploy/restart).
#   Set them                       -> uploads go to permanent S3-compatible cloud
#                                     storage; the product stores its public URL.
#
# PRODUCTION uses Supabase Storage (S3-compatible). One-time setup:
#   1. supabase.com -> new project (free). Storage -> new PUBLIC bucket:
#      name it "product-media".
#   2. Storage -> S3 Connection -> "New access key" -> copy the key id + secret.
#   3. Fill the four vars below. No S3_PUBLIC_BASE_URL needed — it is derived
#      from the Supabase endpoint automatically.
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=product-media
# Supabase S3 endpoint:  https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
# Only set this to override the derived public URL (custom CDN / non-Supabase S3).
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
# Local disk fallback settings (used only when the cloud vars above are unset).
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_MB=15
# Allow product video uploads (mp4 / webm). Images always allowed.
MEDIA_ALLOW_VIDEO=false

# Optional: AI product-attribute suggestions from a product image.
# Anthropic Claude (vision). Leave blank to hide the "Suggest with AI" button.
# Suggestions are advisory only — price/SKU/stock/specs are never AI-generated.
ANTHROPIC_API_KEY=
AI_SUGGEST_MODEL=claude-3-5-haiku-latest

# -----------------------------------------------------------------------------
# Payment gateways
#   - Cash on Delivery is always available (no keys).
#   - With no gateway keys set, online payment uses a built-in SANDBOX simulator
#     (dev/CI only — automatically disabled when NODE_ENV=production).
#     Set PAYMENTS_MOCK_ENABLED=false to turn it off in development too.
#   - RAZORPAY: set all three below to take real card / UPI / net-banking payments.
#       KEY_ID / KEY_SECRET  -> Razorpay Dashboard > Settings > API Keys
#       WEBHOOK_SECRET       -> Razorpay Dashboard > Settings > Webhooks
#       Webhook URL to register:
#         https://<api-host>/api/v1/webhooks/payments/razorpay
#       Subscribe to events:  payment.captured, payment.failed, order.paid
#   The server verifies the checkout signature AND the webhook signature (HMAC
#   SHA-256) before an order is marked paid.
# -----------------------------------------------------------------------------
PAYMENTS_MOCK_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# Cash on Delivery is a built-in method (no keys). Toggle in Admin > Settings.

# -----------------------------------------------------------------------------
# Shipping / logistics — Shiprocket (courier aggregator)
# -----------------------------------------------------------------------------
# Credentials of a Shiprocket "API user" (Shiprocket panel -> Settings -> API
# -> Configure -> Create an API User). NOT your main login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact nickname of a VERIFIED pickup address (Settings -> Company -> Pickup
# Addresses). If unset, the first pickup address on the account is used.
SHIPROCKET_PICKUP_LOCATION=
# Random secret. Paste the same value into Shiprocket's webhook config; it is
# sent back as the `x-api-key` header and the webhook is rejected without it.
# Webhook URL to register:
#   https://<api-host>/api/v1/webhooks/logistics
#   (NOT "…/shiprocket" — Shiprocket's validator blocks URLs containing that word)
SHIPROCKET_WEBHOOK_TOKEN=
# Optional: restrict created orders to one Shiprocket sales channel.
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# Push confirmed orders to Shiprocket automatically (and auto-assign an AWB).
SHIPROCKET_AUTO_CREATE=true
SHIPROCKET_AUTO_ASSIGN_AWB=true
# Fallback parcel size/weight when a product has no weight set.
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=25
SHIPROCKET_DEFAULT_BREADTH_CM=20
SHIPROCKET_DEFAULT_HEIGHT_CM=5

DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=

BLUEDART_LICENSE_KEY=
BLUEDART_LOGIN_ID=

# Checkout PIN-code validation — auto-fills City/State and blocks fake addresses.
# api.postalpincode.in is a keyless India Post wrapper, so no secret is needed;
# resolved PINs are cached in the ServiceablePincode table. Set PINCODE_PROVIDER
# to "none" to run fully offline (small built-in metro list only).
PINCODE_PROVIDER=indiapost
PINCODE_API_BASE_URL=https://api.postalpincode.in
PINCODE_LOOKUP_TIMEOUT_MS=4000
PINCODE_CACHE_TTL_DAYS=90

# -----------------------------------------------------------------------------
# Email (order confirmations + newsletter welcome)
# -----------------------------------------------------------------------------
# The EmailService picks a transport automatically:
#   - RESEND_API_KEY set            -> Resend HTTPS API (needs a verified domain)
#   - SMTP_HOST + SMTP_USER set     -> SMTP via nodemailer
#   - neither                       -> emails are skipped. Orders and newsletter
#                                      signups still work and are recorded; only
#                                      the outbound email is not sent.
# COD checkout, order tracking and the admin subscriber list all work with NO
# email config. Configure this before launch so customers get order emails.
#
# Gmail SMTP (simplest for Velor House — uses velorhouse@gmail.com):
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an App Password (Google Account > Security > App passwords).
#   3. Set:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#            SMTP_USER=velorhouse@gmail.com  SMTP_PASSWORD=<the 16-char app password>
#            EMAIL_FROM="Velor House <velorhouse@gmail.com>"
EMAIL_PROVIDER=smtp            # smtp | ses | resend  (informational; transport is auto-detected)
EMAIL_FROM="Velor House <velorhouse@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# SMS + WhatsApp
# -----------------------------------------------------------------------------
SMS_PROVIDER=msg91             # msg91 | twilio  — used for the customer-login OTP fallback
MSG91_AUTH_KEY=                # secret. Also validates MSG91 OTP-widget access tokens server-side.
# MSG91 Secure OTP widget — PUBLIC values from MSG91 → OTP → your widget → Configuration.
# With all three MSG91_* set, the storefront uses the widget (send + verify in the
# browser); the server confirms every token. Leave the widget vars blank to fall
# back to the API texting its own code (needs SENDER_ID / OTP_TEMPLATE_ID or Twilio).
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN_AUTH=
MSG91_SENDER_ID=               # 6-char DLT sender id, e.g. VELORH (SMS fallback)
MSG91_OTP_TEMPLATE_ID=         # MSG91 "OTP" flow template id (SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                   # a Twilio phone number OR a Messaging Service SID (MG…)

# Customer mobile-OTP login. If no SMS provider is configured the API logs the
# code to the server console (non-production only) so you can still test.
OTP_PEPPER=                    # optional extra secret for hashing OTPs (defaults to JWT secret)
OTP_TTL_SEC=300               # how long a code stays valid
OTP_RESEND_COOLDOWN_SEC=30    # min seconds between "Resend OTP"
OTP_MAX_ATTEMPTS=5            # wrong tries before a code locks
OTP_MAX_RESENDS=4            # resends allowed per number per challenge

WHATSAPP_PROVIDER=meta         # meta | gupshup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Analytics / marketing (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Rate limiting / security
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_VOICE_SEARCH=true
FEATURE_LOYALTY=true
FEATURE_BLOG=true
